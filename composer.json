{
    "name": "oliverklee/anagram-finder",
    "description": "A tool for finding anagrams from a list of words (as an exercise of test-driven development).",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "keywords": [
        "tdd",
        "kata",
        "example",
        "exercise",
        "anagrams"
    ],
    "authors": [
        {
            "name": "Oliver Klee",
            "email": "typo3-coding@oliverklee.de",
            "homepage": "https://www.oliverklee.de/",
            "role": "developer"
        }
    ],
    "homepage": "https://github.com/oliverklee-de/tdd-reader",
    "support": {
        "issues": "https://github.com/oliverklee-de/anagram-finder/issues",
        "source": "https://github.com/oliverklee-de/anagram-finder"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52.0",
        "friendsofphp/php-cs-fixer": "^3.95.17",
        "infection/infection": "^0.34.1",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.7",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^12.5.22",
        "rector/rector": "^2.5.8",
        "rector/type-perfect": "^2.1.4",
        "typo3/coding-standards": "^0.9.0"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "OliverKlee\\Anagrams\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OliverKlee\\Anagrams\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "ocramius/package-versions": true,
            "phpstan/extension-installer": true
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@check:static",
            "@check:tests"
        ],
        "check:composer": [
            "@check:composer:normalize",
            "@check:composer:psr-verify"
        ],
        "check:composer:normalize": "@composer normalize --no-check-lock --dry-run",
        "check:composer:psr-verify": "@composer dumpautoload --optimize --strict-psr --no-plugins",
        "check:php": [
            "@check:php:lint",
            "@check:php:rector",
            "@check:php:cs-fixer",
            "@check:php:stan"
        ],
        "check:php:cs-fixer": "php-cs-fixer fix --config=./Build/php-cs-fixer/config.php -v --dry-run --diff --show-progress=dots",
        "check:php:lint": "parallel-lint Build src tests",
        "check:php:rector": "rector process --dry-run --config=./Build/rector/config.php",
        "check:php:stan": "phpstan --no-progress -v --configuration=./Build/phpstan/phpstan.neon",
        "check:static": [
            "@check:composer",
            "@check:php"
        ],
        "check:tests": [
            "@check:tests:unit",
            "@check:tests:functional"
        ],
        "check:tests:functional": "phpunit --config=./Build/phpunit/config.xml tests/Functional",
        "check:tests:unit": "phpunit --config=./Build/phpunit/config.xml tests/Unit",
        "fix": [
            "@fix:composer:normalize",
            "@fix:php:rector"
        ],
        "fix:composer:normalize": "@composer normalize --no-check-lock",
        "fix:php": [
            "@fix:php:rector",
            "@fix:php:cs-fixer"
        ],
        "fix:php:cs-fixer": "php-cs-fixer fix --config=./Build/php-cs-fixer/config.php",
        "fix:php:rector": "rector process --config=./Build/rector/config.php",
        "phpstan:baseline": "phpstan --configuration=./Build/phpstan/phpstan.neon --allow-empty-baseline --generate-baseline=./Build/phpstan/phpstan-baseline.neon"
    },
    "scripts-descriptions": {
        "check": "Runs all dynamic and static code checks.",
        "check:composer": "Runs all Composer-related static checks.",
        "check:composer:normalize": "Checks the composer.json.",
        "check:composer:psr-verify": "Verifies PSR-4 namespace correctness.",
        "check:php": "Runs all static checks for PHP files.",
        "check:php:cs-fixer": "Checks the code style with the PHP Coding Standards Fixer (PHP-CS-Fixer).",
        "check:php:lint": "Lints the PHP files for syntax errors.",
        "check:php:rector": "Checks for code for changes by Rector.",
        "check:php:stan": "Checks the PHP types using PHPStan.",
        "check:static": "Runs all static code checks (syntax, style, types).",
        "check:tests": "Runs all tests (unit and functional).",
        "check:tests:functional": "Runs the functional tests.",
        "check:tests:unit": "Runs the unit tests.",
        "fix": "Runs all automatic code style fixes.",
        "fix:composer:normalize": "Normalizes all composer.json files.",
        "fix:php": "Runs all fixers for the PHP code.",
        "fix:php:fixer": "Fixes the code style with PHP-CS-Fixer.",
        "fix:php:rector": "Updates the code with Rector.",
        "phpstan:baseline": "Updates the PHPStan baseline file to match the code."
    }
}
